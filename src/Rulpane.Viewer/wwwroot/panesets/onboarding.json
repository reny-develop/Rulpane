{
  "$schema": "rulpane/paneset/v1",
  // A new starter's onboarding: four steps, ticked in any order, one done already. Checklist
  // projects nothing, so the lists the progress view reads are its state fields.
  "r": "checklist",
  "v": "progress",
  "b": { "all": "$steps", "done": "$done" },
  "s": { "steps": ["contract", "equipment", "induction", "payroll"], "done": ["contract"] }
}
