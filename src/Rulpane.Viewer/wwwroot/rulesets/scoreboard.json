{
  "$schema": "rulealize/ruleset/v1",
  "id": "scoreboard",
  "version": "1.1.0",

  // Points for each player, round after round, and who is ahead. Whatever the game — bowling,
  // golf, cards, a quiz — the scorer adds the players and enters each score as it comes.
  // A score may be negative, for the games that take points away. Nobody leads before the first.

  "requires": [
    { "plugin": "Rulealize.Plugin.TypeSchema", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.State", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Sequence", "version": "^1.3" },
    { "plugin": "Rulealize.Plugin.Record", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Comparison", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Logic", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Arithmetic", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Branch", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Binding", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Definition", "version": "^1.0" }
  ],

  "state": {
    "schema": {
      "players": { "op": "type.list", "element": { "op": "type.string", "minLength": 1, "maxLength": 20 } },
      "scores": {
        "op": "type.list",
        "element": {
          "op": "rec.of",
          "fields": {
            "player": { "op": "type.string", "minLength": 1, "maxLength": 20 },
            "points": { "op": "type.int", "min": -100000, "max": 100000 }
          }
        }
      }
    },
    "initial": { "players": [], "scores": [] }
  },

  "definitions": {
    "of": {
      "params": ["who"],
      "body": { "op": "seq.where", "source": "$scores", "as": "s", "predicate": { "op": "cmp.eq", "left": { "op": "rec.at", "record": "@s", "key": "player" }, "right": "@who" } }
    },
    "total": {
      "params": ["who"],
      "body": { "op": "seq.sum", "source": { "op": "def.call", "def": "of", "args": { "who": "@who" } }, "as": "s", "select": { "op": "rec.at", "record": "@s", "key": "points" } }
    },
    "totals": {
      "op": "seq.select", "source": "$players", "as": "p",
      "select": { "op": "def.call", "def": "total", "args": { "who": "@p" } }
    },
    "best": {
      "op": "branch.if",
      "cond": { "op": "cmp.eq", "left": { "op": "seq.count", "source": "$players" }, "right": 0 },
      "then": 0,
      "else": {
        "op": "seq.elementAt", "index": 0,
        "source": {
          "op": "seq.where", "source": "#totals", "as": "t",
          "predicate": { "op": "logic.not", "value": { "op": "seq.any", "source": "#totals", "as": "u", "predicate": { "op": "cmp.gt", "left": "@u", "right": "@t" } } }
        }
      }
    }
  },

  "inputs": {
    "join": {
      "params": { "name": { "open": { "op": "type.string", "minLength": 1, "maxLength": 20 } } },
      "validate": [
        {
          "require": {
            "op": "logic.not",
            "value": { "op": "seq.any", "source": "$players", "as": "n", "predicate": { "op": "cmp.eq", "left": "@n", "right": "@name" } }
          },
          "code": "name.taken"
        }
      ],
      "effects": [
        { "op": "state.set", "path": "players", "value": { "op": "seq.concat", "of": ["$players", { "op": "seq.of", "of": ["@name"] }] } }
      ]
    },
    "score": {
      "params": {
        "player": { "domain": "$players" },
        "points": { "open": { "op": "type.int", "min": -100000, "max": 100000 } }
      },
      "effects": [
        {
          "op": "state.set", "path": "scores",
          "value": { "op": "seq.concat", "of": ["$scores", { "op": "seq.of", "of": [{ "player": "@player", "points": "@points" }] }] }
        }
      ]
    },
    // A player taken off the list goes with their scores.
    "leave": {
      "params": { "name": { "domain": "$players" } },
      "effects": [
        { "op": "state.set", "path": "players", "value": { "op": "seq.where", "source": "$players", "as": "n", "predicate": { "op": "cmp.ne", "left": "@n", "right": "@name" } } },
        {
          "op": "state.set", "path": "scores",
          "value": { "op": "seq.where", "source": "$scores", "as": "s", "predicate": { "op": "cmp.ne", "left": { "op": "rec.at", "record": "@s", "key": "player" }, "right": "@name" } }
        }
      ]
    },
    // Every player and every score, for the next game or to start from a sample with your own.
    "clear": {
      "when": { "op": "logic.or", "any": [
        { "op": "cmp.gt", "left": { "op": "seq.count", "source": "$players" }, "right": 0 },
        { "op": "cmp.gt", "left": { "op": "seq.count", "source": "$scores" }, "right": 0 }
      ] },
      "effects": [
        { "op": "state.set", "path": "players", "value": { "op": "seq.of", "of": [] } },
        { "op": "state.set", "path": "scores", "value": { "op": "seq.of", "of": [] } }
      ]
    },
    // A score entered wrong is taken back from the end.
    "undo": {
      "when": { "op": "cmp.gt", "left": { "op": "seq.count", "source": "$scores" }, "right": 0 },
      "effects": [
        {
          "op": "state.set", "path": "scores",
          "value": { "op": "seq.take", "source": "$scores", "count": { "op": "math.sub", "left": { "op": "seq.count", "source": "$scores" }, "right": 1 } }
        }
      ]
    }
  },

  "projections": {
    "standings": {
      "op": "seq.select", "source": "$players", "as": "p",
      "select": {
        "op": "bind.let",
        "bind": { "total": { "op": "def.call", "def": "total", "args": { "who": "@p" } } },
        "in": {
          "player": "@p",
          "rounds": { "op": "seq.count", "source": { "op": "def.call", "def": "of", "args": { "who": "@p" } } },
          "total": "@total",
          "leading": {
            "op": "branch.if",
            "cond": { "op": "logic.and", "all": [
              { "op": "cmp.gt", "left": { "op": "seq.count", "source": "$scores" }, "right": 0 },
              { "op": "cmp.eq", "left": "@total", "right": "#best" }
            ] },
            "then": "★", "else": ""
          }
        }
      }
    },
    "scores": "$scores"
  }
}
