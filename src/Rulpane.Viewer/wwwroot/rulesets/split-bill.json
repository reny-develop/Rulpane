{
  "$schema": "rulealize/ruleset/v1",
  "id": "split-bill",
  "version": "1.1.0",

  // Who paid for what on a trip or a night out, and what each owes or is owed when it is
  // shared equally. Amounts are whole units of the currency; the share is rounded to the
  // nearest one, so the pays and the receives can differ by a unit or two.

  "requires": [
    { "plugin": "Rulealize.Plugin.TypeSchema", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.State", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Sequence", "version": "^1.3" },
    { "plugin": "Rulealize.Plugin.Record", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Comparison", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Logic", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Arithmetic", "version": "^1.1" },
    { "plugin": "Rulealize.Plugin.Branch", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Binding", "version": "^1.0" },
    { "plugin": "Rulealize.Plugin.Definition", "version": "^1.0" }
  ],

  "state": {
    "schema": {
      "people": { "op": "type.list", "element": { "op": "type.string", "minLength": 1, "maxLength": 20 } },
      "payments": {
        "op": "type.list",
        "element": {
          "op": "rec.of",
          "fields": {
            "who": { "op": "type.string", "minLength": 1, "maxLength": 20 },
            "what": { "op": "type.string", "minLength": 1, "maxLength": 40 },
            "amount": { "op": "type.int", "min": 1, "max": 10000000 }
          }
        }
      }
    },
    "initial": { "people": [], "payments": [] }
  },

  "definitions": {
    "total": { "op": "seq.sum", "source": "$payments", "as": "p", "select": { "op": "rec.at", "record": "@p", "key": "amount" } },

    // Each one's equal part of the total; nothing while nobody has joined.
    "share": {
      "op": "branch.if",
      "cond": { "op": "cmp.eq", "left": { "op": "seq.count", "source": "$people" }, "right": 0 },
      "then": 0,
      "else": {
        "op": "math.round", "mode": "halfAwayFromZero",
        "value": { "op": "math.div", "left": "#total", "right": { "op": "seq.count", "source": "$people" } }
      }
    },

    "paid": {
      "params": ["who"],
      "body": {
        "op": "seq.sum",
        "source": { "op": "seq.where", "source": "$payments", "as": "p", "predicate": { "op": "cmp.eq", "left": { "op": "rec.at", "record": "@p", "key": "who" }, "right": "@who" } },
        "as": "p",
        "select": { "op": "rec.at", "record": "@p", "key": "amount" }
      }
    }
  },

  "inputs": {
    "join": {
      "params": { "name": { "open": { "op": "type.string", "minLength": 1, "maxLength": 20 } } },
      "validate": [
        {
          "require": {
            "op": "logic.not",
            "value": { "op": "seq.any", "source": "$people", "as": "n", "predicate": { "op": "cmp.eq", "left": "@n", "right": "@name" } }
          },
          "code": "name.taken"
        }
      ],
      "effects": [
        { "op": "state.set", "path": "people", "value": { "op": "seq.concat", "of": ["$people", { "op": "seq.of", "of": ["@name"] }] } }
      ]
    },
    "pay": {
      "params": {
        "who": { "domain": "$people" },
        "what": { "open": { "op": "type.string", "minLength": 1, "maxLength": 40 } },
        "amount": { "open": { "op": "type.int", "min": 1, "max": 10000000 } }
      },
      "effects": [
        {
          "op": "state.set", "path": "payments",
          "value": { "op": "seq.concat", "of": ["$payments", { "op": "seq.of", "of": [{ "who": "@who", "what": "@what", "amount": "@amount" }] }] }
        }
      ]
    },
    // A name spelt wrong is put right, and what they paid goes with it.
    "rename": {
      "params": {
        "name": { "domain": "$people" },
        "to": { "open": { "op": "type.string", "minLength": 1, "maxLength": 20 } }
      },
      "validate": [
        {
          "require": {
            "op": "logic.not",
            "value": { "op": "seq.any", "source": "$people", "as": "n", "predicate": { "op": "cmp.eq", "left": "@n", "right": "@to" } }
          },
          "code": "name.taken"
        }
      ],
      "effects": [
        {
          "op": "state.set", "path": "people",
          "value": { "op": "seq.select", "source": "$people", "as": "n", "select": { "op": "branch.if", "cond": { "op": "cmp.eq", "left": "@n", "right": "@name" }, "then": "@to", "else": "@n" } }
        },
        {
          "op": "state.set", "path": "payments",
          "value": {
            "op": "seq.select", "source": "$payments", "as": "r",
            "select": {
              "op": "branch.if",
              "cond": { "op": "cmp.eq", "left": { "op": "rec.at", "record": "@r", "key": "who" }, "right": "@name" },
              "then": { "who": "@to", "what": { "op": "rec.at", "record": "@r", "key": "what" }, "amount": { "op": "rec.at", "record": "@r", "key": "amount" } },
              "else": "@r"
            }
          }
        }
      ]
    },
    // Someone taken off the list goes with what they paid, so the rest is shared among those left.
    "leave": {
      "params": { "name": { "domain": "$people" } },
      "effects": [
        { "op": "state.set", "path": "people", "value": { "op": "seq.where", "source": "$people", "as": "n", "predicate": { "op": "cmp.ne", "left": "@n", "right": "@name" } } },
        {
          "op": "state.set", "path": "payments",
          "value": { "op": "seq.where", "source": "$payments", "as": "p", "predicate": { "op": "cmp.ne", "left": { "op": "rec.at", "record": "@p", "key": "who" }, "right": "@name" } }
        }
      ]
    },
    // Everybody and every payment, for the next trip or to start from a sample with your own.
    "clear": {
      "when": { "op": "logic.or", "any": [
        { "op": "cmp.gt", "left": { "op": "seq.count", "source": "$people" }, "right": 0 },
        { "op": "cmp.gt", "left": { "op": "seq.count", "source": "$payments" }, "right": 0 }
      ] },
      "effects": [
        { "op": "state.set", "path": "people", "value": { "op": "seq.of", "of": [] } },
        { "op": "state.set", "path": "payments", "value": { "op": "seq.of", "of": [] } }
      ]
    },
    // A payment entered wrong is taken back from the end, the one most likely to be wrong.
    "undo": {
      "when": { "op": "cmp.gt", "left": { "op": "seq.count", "source": "$payments" }, "right": 0 },
      "effects": [
        {
          "op": "state.set", "path": "payments",
          "value": { "op": "seq.take", "source": "$payments", "count": { "op": "math.sub", "left": { "op": "seq.count", "source": "$payments" }, "right": 1 } }
        }
      ]
    }
  },

  "projections": {
    "payments": "$payments",
    "summary": {
      "total": "#total",
      "share": "#share",
      "people": { "op": "seq.count", "source": "$people" }
    },
    "balances": {
      "op": "seq.select", "source": "$people", "as": "n",
      "select": {
        "op": "bind.let", "bind": { "paid": { "op": "def.call", "def": "paid", "args": { "who": "@n" } } },
        "in": {
          "name": "@n",
          "paid": "@paid",
          "pays": { "op": "math.max", "of": [0, { "op": "math.sub", "left": "#share", "right": "@paid" }] },
          "receives": { "op": "math.max", "of": [0, { "op": "math.sub", "left": "@paid", "right": "#share" }] }
        }
      }
    }
  }
}
