{
  "$schema": "rulealize/view/v1",
  "ruleSet": "countdown@1",
  "title": "Count to ten",
  "layout": [
    // countdown projects nothing, so the view reads the state the way the rules do: $total.
    { "c": "stats", "items": [ { "label": "Total", "bind": "$total" } ] },
    { "c": "actions", "title": "Add", "inputs": "*" }
  ],
  "names": {
    "inputs": { "add": "Add" },
    "params": { "n": "how many" },
    "values": { "done": "Ten, exactly" }
  }
}
