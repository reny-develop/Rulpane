{
  "$schema": "rulealize/view/v1",
  "ruleSet": "tictactoe@1",
  // The turn is a projection of the name the template expects, so only the board needs binding:
  // no rules can project a board, so a board is always a state field.
  "template": "grid-game",
  "bind": {
    "projections": { "board": "$board" }
  },
  "title": "Tic-tac-toe",
  "names": {
    "values": { "x": "×", "o": "○", "draw": "Draw" }
  }
}
