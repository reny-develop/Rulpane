{
  "$schema": "rulealize/view/v1",
  // A view for a game on a Grid board, taken in turns by choosing a square.
  // Any other move, such as a pass, is under the board: "*" leaves out what the squares offer.
  "expects": {
    "projections": { "board": "board", "turn": "string" },
    "inputs": { "place": ["at"] }
  },
  "layout": [
    { "c": "fields", "rows": [ { "label": "To move", "bind": "turn" } ] },
    { "c": "board", "bind": "board", "play": "place.at", "pieces": { "black": "dark", "white": "light" } },
    { "c": "actions", "title": "Other moves", "inputs": "*" }
  ],
  "names": {
    "inputs": { "place": "Place" },
    "params": { "at": "square" }
  }
}
