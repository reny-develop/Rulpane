{
  "$schema": "rulealize/view/v1",
  "ruleSet": "approval@1",
  // The stages template on rules that keep the stage under another name: `bind` says where.
  "template": "stages",
  "bind": {
    "projections": { "stage": "summary.stage" }
  },
  "title": "Expense claim",
  "names": {
    "inputs": { "submit": "Submit the claim", "approve": "Approve", "reject": "Send back" },
    "params": { "reason": "Why" },
    "values": { "rejected": "Sent back", "scope": "Out of scope", "cost": "Costs too much", "timing": "Bad timing" }
  }
}
