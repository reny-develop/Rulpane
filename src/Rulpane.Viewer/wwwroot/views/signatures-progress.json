{
  "$schema": "rulealize/view/v1",
  "ruleSet": "Rulealize.RuleSet.Signatures@1",
  // The same template as the checklist's: who may sign is "all", who has signed is "done".
  "template": "progress",
  "bind": {
    "projections": { "all": "signatories", "done": "signed" }
  },
  "title": "Two signatures to go ahead",
  "names": {
    "inputs": { "sign": "Sign", "decline": "Decline" },
    "params": { "who": "who" },
    "values": { "signed": "Signed", "refused": "Declined" }
  }
}
