@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components.Routing
@using Rulealize
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

<header class="bar">
    <a class="brand" href="@BaseUri">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <rect width="22" height="22" rx="6" fill="var(--color-accent)" />
            <rect x="5" y="5" width="5" height="12" rx="1.5" fill="var(--color-accent-text)" />
            <rect x="12" y="5" width="5" height="5" rx="1.5" fill="var(--color-accent-text)" fill-opacity="0.55" />
            <rect x="12" y="12" width="5" height="5" rx="1.5" fill="var(--color-accent-text)" />
        </svg>
        Rulpane
    </a>
    @if (session is not null)
    {
        <span class="crumb">@Id</span>
    }
    <span class="spacer"></span>
    <nav class="bar-links">
        <a class="button ghost small" href="@BaseUri">Samples</a>
        <a class="button ghost small" href="@(BaseUri + "#" + MakeFragment)"><Icon Name="code" Size="14" />Make a link</a>
    </nav>
</header>

<main>
    @if (loading)
    {
        <p class="muted">Loading…</p>
    }
    else if (error is not null)
    {
        <section class="card failure">
            <span class="failure-icon"><Icon Name="alert" Size="20" /></span>
            <h1>This link cannot be opened</h1>
            <p>Rulpane could not read the rules it names. Nothing was run.</p>
            <pre><strong>@error.Value.Type</strong>@error.Value.Message</pre>
            <div class="actions">
                <a class="button primary" href="@BaseUri"><Icon Name="back" />Back to the start</a>
                <button @onclick="CopyError"><Icon Name="@(copied ? "check" : "copy")" />@(copied ? "Copied" : "Copy details")</button>
            </div>
        </section>
    }
    else if (session is null)
    {
        <Landing BaseUri="@BaseUri" Runtime="Runtime" FocusEditor="@(loadedFragment == MakeFragment)" />
    }
    else
    {
        <div class="play">
            @* Pinned on a narrow screen, so the moves never scroll away under a long view. *@
            <div class="pinned">
                <header class="play-head">
                    <div class="titles">
                        <div class="title-row">
                            <h1>@Id</h1>
                            @if (terminal.IsTerminal)
                            {
                                <span class="chip ok dot">Finished</span>
                            }
                            else
                            {
                                <span class="chip accent dot">In progress</span>
                            }
                        </div>
                        <span class="sub">@session.Context.RuleSet · @(source is { IsBundled: true } ? "bundled" : "embedded in the link")</span>
                    </div>
                    <div class="actions">
                        <button @onclick="Restart" title="Start over"><Icon Name="restart" /><span class="label">Start over</span></button>
                        <button @onclick="CopyLink" title="Copy link"><Icon Name="@(copied ? "check" : "link")" /><span class="label">@(copied ? "Copied" : "Copy link")</span></button>
                    </div>
                </header>

                @if (source is { IsBundled: false })
                {
                    <p class="notice"><Icon Name="shield" />These rules came in the link. Nobody has verified who wrote them.</p>
                }

                @if (lastMove is not null)
                {
                    <p class="last-move">
                        <span class="chip mark">Last move</span>
                        <span class="move-text">@lastMove</span>
                        @if (lastDraws.Length > 0)
                        {
                            <span class="drew"><Icon Name="dice" Size="14" />drew @string.Join(", ", lastDraws)</span>
                        }
                        <span class="undo"><Icon Name="back" Size="14" />Back to undo</span>
                    </p>
                }

                @if (terminal.IsTerminal)
                {
                    <section class="side result">
                        <div class="result-head"><Icon Name="flag" />The rules have ended</div>
                        <div class="result-value">
                            <span class="key">result</span>
                            <span class="value">@(terminal.Result is null ? "—" : Display.Unquote(terminal.Result))</span>
                        </div>
                        <p>No moves are left. Share the link to hand over the finished position.</p>
                    </section>
                }
                else if (moves is not null)
                {
                    <MovePanel Moves="moves" OnPlay="p => Play(p.Move, p.Open)" Refused="refused" Refusals="refusals" Rejection="@rejection" />
                }
            </div>

            <div class="view">
                @if (projections.Count > 0)
                {
                    @foreach (var (name, value) in projections)
                    {
                        <section class="card">
                            <div class="card-head"><h2 class="mono">@name</h2><span class="chip">projection</span></div>
                            <ValueView Value="value" Top="true" />
                        </section>
                    }
                }
                else
                {
                    <section class="card">
                        <div class="card-head"><h2>State</h2><span class="chip">no projections</span><span class="meta">shown as it is</span></div>
                        <ValueView Value="session.Data" Top="true" />
                    </section>
                }
            </div>
        </div>
    }
</main>

@code {
    private static readonly RuleRuntime Runtime = CuratedRuntime.Create();

    // A fragment with no rules in it shows the start; this one also puts the cursor in the editor.
    private const string MakeFragment = "make";

    // Compiling is the expensive part, and a rule set does not change while its state does.
    private readonly Dictionary<string, RuleContext> compiled = new(StringComparer.Ordinal);

    private bool loading = true;
    private (string Type, string Message)? error;
    private string? lastMove;
    private string[] lastDraws = [];
    private ValidInput? refused;
    private IReadOnlyDictionary<string, string[]>? refusals;
    private string? rejection;
    private bool copied;
    private RuleSource? source;
    private Session? session;
    private TerminalStatus terminal;
    private ValidInputSet? moves;
    private List<(string Name, JsonNode? Value)> projections = [];

    private string BaseUri => Nav.BaseUri;

    // The rule set's id: the identity without the version the sub-title already gives.
    private string Id => session!.Context.RuleSet.Split('@')[0];

    private IJSObjectReference? module;
    private IJSObjectReference? listener;
    private DotNetObjectReference<App>? self;
    private string? loadedFragment;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await LoadAsync(new Uri(Nav.Uri).Fragment);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fragment.js");
            self = DotNetObjectReference.Create(this);
            listener = await module.InvokeAsync<IJSObjectReference>("listen", self);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        if (listener is not null)
        {
            await listener.InvokeVoidAsync("dispose");
            await listener.DisposeAsync();
        }

        if (module is not null)
        {
            await module.DisposeAsync();
        }

        self?.Dispose();
    }

    [JSInvokable]
    public async Task OnFragmentChanged(string fragment)
    {
        if (await LoadAsync(fragment, fromOutside: true))
        {
            StateHasChanged();
        }
    }

    // A link clicked inside the page goes through Blazor's router rather than the browser.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (await LoadAsync(new Uri(e.Location).Fragment, fromOutside: true))
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// The URL is the only place a position lives, so every render starts from it. Returns
    /// whether anything was loaded; the same fragment reported twice is loaded once.
    /// </summary>
    private async Task<bool> LoadAsync(string fragmentText, bool fromOutside = false)
    {
        fragmentText = fragmentText.TrimStart('#');
        if (fragmentText == loadedFragment)
        {
            return false;
        }

        // A position reached by the back button or a pasted link was not reached by the move
        // this page last made, so what that move did is no longer what is on screen.
        if (fromOutside)
        {
            lastMove = null;
            lastDraws = [];
        }

        loadedFragment = fragmentText;
        loading = false;
        error = null;
        ClearRejection();
        copied = false;
        session = null;

        var fragment = Fragment.Parse(fragmentText);
        if (!fragment.TryGetValue("r", out string? rules))
        {
            source = null;
            return true;
        }

        try
        {
            source = RuleSource.Parse(rules);
            if (!compiled.TryGetValue(rules, out RuleContext? context))
            {
                context = Runtime.CreateContext(await source.ReadAsync(Http));
                compiled[rules] = context;
            }

            session = Session.Open(context, fragment.GetValueOrDefault("s"));
            terminal = session.Terminal;
            moves = terminal.IsTerminal ? null : session.ValidInputs();
            projections = session.Context.Projections.Select(name => (name, session.Project(name))).ToList();
        }
        catch (Exception e)
        {
            session = null;
            error = (e.GetType().Name, e.Message);
        }

        return true;
    }

    private async Task Play(ValidInput move, IReadOnlyDictionary<string, JsonNode?>? open)
    {
        if (session is null || source is null)
        {
            return;
        }

        string next;
        try
        {
            Outcome outcome = session.Apply(move, open);
            lastMove = Describe(move, open);
            lastDraws = [.. outcome.Draws];
            next = FragmentFor(Session.PackData(outcome.Result.State));
        }
        catch (InputRejectedException e)
        {
            // A refusal about one parameter belongs under its field; the rest go under the moves.
            refused = move;
            refusals = e.Rejections
                .Where(r => r.Parameter is not null)
                .GroupBy(r => r.Parameter!)
                .ToDictionary(g => g.Key, g => g.Select(r => r.Code).ToArray());
            var rest = e.Rejections.Where(r => r.Parameter is null).Select(r => r.Code).Concat(e.Unexplained).ToList();
            rejection = rest.Count > 0 ? string.Join(" / ", rest) : null;
            return;
        }
        catch (Exception e)
        {
            ClearRejection();
            rejection = e.Message;
            return;
        }

        await GoAsync(next);
    }

    // A move with open parameters prints them as still to come; what was played had them typed in.
    private static string Describe(ValidInput move, IReadOnlyDictionary<string, JsonNode?>? open)
    {
        if (open is null)
        {
            return move.ToString();
        }

        var arguments = move.Arguments.Select(a => $"{a.Key}: {Display.Unquote(a.Value)}")
            .Concat(open.Select(o => $"{o.Key}: {(o.Value is null ? "null" : Display.Unquote(o.Value.ToJsonString()))}"));
        return $"{move.Input}({string.Join(", ", arguments)})";
    }

    private void ClearRejection()
    {
        refused = null;
        refusals = null;
        rejection = null;
    }

    private async Task Restart()
    {
        lastMove = null;
        lastDraws = [];
        await GoAsync(FragmentFor(null));
    }

    // Loaded here rather than on the event that follows, so the screen never waits on it.
    private async Task GoAsync(string fragment)
    {
        await LoadAsync(fragment);
        if (module is not null)
        {
            await module.InvokeVoidAsync("go", fragment);
        }
    }

    private async Task CopyLink()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", BaseUri + "#" + loadedFragment);
        copied = true;
    }

    private async Task CopyError()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"{error!.Value.Type}\n{error.Value.Message}\n{BaseUri}#{loadedFragment}");
        copied = true;
    }

    private string FragmentFor(string? packedData) =>
        Fragment.Build(("r", source!.Value), ("s", packedData));
}
