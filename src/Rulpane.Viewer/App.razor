@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components.Routing
@using Rulealize
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

<header class="bar">
    <a class="brand" href="@BaseUri">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <rect width="22" height="22" rx="6" fill="var(--color-accent)" />
            <rect x="5" y="5" width="5" height="12" rx="1.5" fill="var(--color-accent-text)" />
            <rect x="12" y="5" width="5" height="5" rx="1.5" fill="var(--color-accent-text)" fill-opacity="0.55" />
            <rect x="12" y="12" width="5" height="5" rx="1.5" fill="var(--color-accent-text)" />
        </svg>
        Rulpane
    </a>
    @if (session is not null && Unverified)
    {
        @* In the bar, which only Rulpane draws, so nothing a link lays out can cover it or imitate it. *@
        <Provenance Documents="Carried" Published="Published" Gallery="gallery" InLink="InLink" />
    }
    else if (session is not null)
    {
        <span class="crumb">@Id</span>
    }
    <span class="spacer"></span>
    <nav class="bar-links">
        <a class="button ghost small" href="@(BaseUri + "#ask")">@Say("Ask an AI", "AI に頼む")</a>
        <a class="button ghost small" href="@(BaseUri + "#guide")">@Say("How to write", "書き方")</a>
        <a class="button ghost small" href="@(BaseUri + "#make")"><Icon Name="code" Size="14" />@Say("Write one", "ここで書く")</a>
    </nav>
</header>

@if (session is not null && theme is not null)
{
    <style>@theme.Css()</style>
}
<main class="@(session is not null && theme is not null ? theme.IsCompact ? "themed compact" : "themed" : null)">
    @if (loading)
    {
        <p class="muted">@Say("Loading…", "読み込み中…")</p>
    }
    else if (error is not null)
    {
        <section class="card failure">
            <span class="failure-icon"><Icon Name="alert" Size="20" /></span>
            <h1>@Say("This link cannot be opened", "このリンクは開けません")</h1>
            <p>@Say("Rulpane could not read the rules or the view it names. Nothing was run.", "リンクが指すルールかビューを Rulpane が読めませんでした。何も実行していません。")</p>
            <pre><strong>@error.Value.Type</strong>@error.Value.Message</pre>
            <div class="actions">
                <a class="button primary" href="@BaseUri"><Icon Name="back" />@Say("Back to the start", "トップに戻る")</a>
                <button @onclick="CopyError"><Icon Name="@(copied ? "check" : "copy")" />@(copied ? Say("Copied", "コピーしました") : Say("Copy details", "詳細をコピー"))</button>
            </div>
        </section>
    }
    else if (session is null)
    {
        <Landing BaseUri="@BaseUri" Runtime="Runtime" Focus="@loadedFragment" />
    }
    else
    {
        <div class="play @(view is null ? null : "laid-out")">
            @* Pinned on a narrow screen, so the moves never scroll away under a long view. *@
            <div class="pinned">
                <header class="play-head">
                    <div class="titles">
                        <div class="title-row">
                            <h1>@(view?.Title ?? Id)</h1>
                            @if (terminal.IsTerminal)
                            {
                                <span class="chip ok dot">@Say("Finished", "終了")</span>
                            }
                            else
                            {
                                <span class="chip accent dot">@Say("In progress", "進行中")</span>
                            }
                        </div>
                        <span class="sub">@Subtitle</span>
                    </div>
                    <div class="actions">
                        <button @onclick="Restart" title="@Say("Start over", "最初から")"><Icon Name="restart" /><span class="label">@Say("Start over", "最初から")</span></button>
                        <button @onclick="CopyLink" title="@Say("Copy link", "リンクをコピー")"><Icon Name="@(copied ? "check" : "link")" /><span class="label">@(copied ? Say("Copied", "コピーしました") : Say("Copy link", "リンクをコピー"))</span></button>
                    </div>
                </header>

                @if (lastMove is not null)
                {
                    <p class="last-move">
                        <span class="chip mark">@Say("Last move", "直前の操作")</span>
                        <span class="move-text">@lastMove</span>
                        @if (lastDraws.Length > 0)
                        {
                            <span class="drew"><Icon Name="dice" Size="14" />@Say($"drew {string.Join(", ", lastDraws.Select(Names.Rendered))}", $"抽選：{string.Join("、", lastDraws.Select(Names.Rendered))}")</span>
                        }
                        <span class="undo"><Icon Name="back" Size="14" />@Say("Back to undo", "ブラウザの「戻る」で取り消し")</span>
                    </p>
                }

                @if (terminal.IsTerminal)
                {
                    <section class="side result">
                        <div class="result-head"><Icon Name="flag" />@Say("The rules have ended", "ルールが終了しました")</div>
                        <div class="result-value">
                            <span class="key">@Say("result", "結果")</span>
                            <span class="value">@(terminal.Result is null ? "—" : Names.Rendered(terminal.Result))</span>
                        </div>
                        <p>@Say("No moves are left. Share the link to hand over the finished position.", "できる操作はもうありません。リンクを共有すれば、終わった状態をそのまま渡せます。")</p>
                    </section>
                }
                else if (moves is not null && view is null)
                {
                    <MovePanel Moves="moves" Truncated="truncated" OnPlay="p => Play(p.Move, p.Open)" Refused="refused" Refusals="refusals" Rejection="rejection" />
                }
            </div>

            <div class="view">
                @if (view is not null)
                {
                    <ViewLayout View="view" Projections="projections" Data="session.Data" Moves="moves" Truncated="truncated"
                                OnPlay="p => Play(p.Move, p.Open)" Refused="refused" Refusals="refusals" Rejection="rejection" />
                }
                else if (projections.Count > 0)
                {
                    @foreach (var (name, value) in projections)
                    {
                        <section class="card">
                            <div class="card-head"><h2 class="mono">@name</h2><span class="chip">projection</span></div>
                            <ValueView Value="value" Top="true" />
                        </section>
                    }
                }
                else
                {
                    <section class="card">
                        <div class="card-head"><h2>@Say("State", "状態")</h2><span class="chip">@Say("no projections", "projection なし")</span><span class="meta">@Say("shown as it is", "そのまま表示")</span></div>
                        <ValueView Value="session.Data" Top="true" />
                    </section>
                }
            </div>
        </div>
    }
</main>

@code {
    private static readonly RuleRuntime Runtime = CuratedRuntime.Create();

    // Compiling is the expensive part, and a rule set does not change while its state does.
    private Opener opener = default!;
    private Opened? opened;

    private bool loading = true;
    private (string Type, string Message)? error;
    private string? lastMove;
    private string[] lastDraws = [];
    private ValidInput? refused;
    private IReadOnlyDictionary<string, string[]>? refusals;
    // Codes the rules refused with that belong to no one field, or what went wrong instead.
    private IReadOnlyList<string>? rejection;
    private bool copied;
    // What the link says of itself, and the paneset its p names, if it names one: the screen is
    // that paneset with the link's own keys put over it.
    private IReadOnlyDictionary<string, string> link = new Dictionary<string, string>();
    private Paneset linked = Paneset.Empty;
    private Source? paneSource;
    private Source? source;
    private Source? viewSource;
    private Source? themeSource;
    private Theme? theme;
    private View? view;
    // The releases from the Gallery the screen is made with, with who published them.
    private List<Published> gallery = [];
    private Session? session;
    private TerminalStatus terminal;
    private List<ValidInput>? moves;
    private bool truncated;
    private Dictionary<string, JsonNode?> projections = [];

    private string BaseUri => Nav.BaseUri;

    // What the view calls the rules' names; the screen without one uses them as they are.
    private Names Names => view?.Names ?? Names.None;

    // The rule set's id: the identity without the version the sub-title already gives.
    private string Id => session!.Context.Id;

    // Whether anything on screen arrived in the link, from the Registry or from the Gallery, rather than with the viewer.
    private bool Unverified => InLink || source is { IsRegistered: true } || Held.Count > 0 || gallery.Count > 0;

    // Whether any document was written into the link itself, rather than named by it. A part a
    // paneset writes in place is its author's: the link's only when the paneset is in the link too.
    private bool InLink =>
        paneSource is { IsPacked: true }
        || new[] { linked.Rules, linked.View, linked.Theme }.Any(v => v?.StartsWith(Fragment.PackedPrefix, StringComparison.Ordinal) == true)
        || linked.Bind.Count > 0;

    private IReadOnlyList<Document> Held => opened?.Held ?? [];

    private IReadOnlyDictionary<Source, string> texts => opened!.Texts;

    // The rule sets from the Registry this screen runs: the rules themselves, and what they hold.
    private List<string> Published =>
        [.. source is { IsRegistered: true } ? new[] { $"{source.Reference.Id} {source.Reference.Version}" } : [],
         .. Held.Select(d => $"{d.Id} {d.Version}")];

    // The documents this screen is made from, as their author wrote them, for whoever wants to read them.
    private List<(string Name, string Text)> Carried =>
        [.. paneSource is null ? [] : new[] { (Named(Say("Paneset", "ペインセット"), paneSource), texts[paneSource]) },
         (Named(Say("Rules", "ルール"), source!), texts[source!]),
         .. Held.Select(d => (Say($"Held: {d.Id} {d.Version}", $"取り込み：{d.Id} {d.Version}"), d.Text)),
         .. viewSource is null ? [] : new[] { (Named(Say("View", "ビュー"), viewSource), texts[viewSource]) },
         .. linked.Bind.Count == 0 ? [] : new[] { (Say("Bindings (b)", "付け替え（b）"), Fragment.Unpack(link["b"])) },
         .. themeSource is null ? [] : new[] { (Named(Say("Theme", "テーマ"), themeSource), texts[themeSource]) }];

    private static string Named(string what, Source source) =>
        source.IsRegistered || source.IsGallery ? $"{what}: {source.Reference.Id} {source.Reference.Version}" : what;

    // Which rules, and where each part came from: bundled, published, written into the paneset, or into the link.
    private string Subtitle =>
        $"{session!.Context.RuleSet} · {From(source!, linked.Rules is not null, Say("bundled", "同梱"))}"
        + (paneSource is null ? "" : paneSource.IsPacked ? Say(" · paneset embedded in the link", " · ペインセットはリンクに埋め込み") : Say($" · paneset {paneSource.Value}", $" · ペインセット {paneSource.Value}"))
        + (viewSource is null ? "" : viewSource.IsPacked ? Say(" · view ", " · ビューは") + From(viewSource, linked.View is not null, "") : Say($" · view {viewSource.Value}", $" · ビュー {viewSource.Value}"))
        + (themeSource is null ? "" : themeSource.IsPacked ? Say(" · theme ", " · テーマは") + From(themeSource, linked.Theme is not null, "") : Say($" · theme {themeSource.Value}", $" · テーマ {themeSource.Value}"));

    private static string From(Source part, bool fromLink, string bundled) =>
        part.IsBundled ? bundled
        : part.IsRegistered ? Say("from the Registry", "Registry から")
        : fromLink ? Say("embedded in the link", "リンクに埋め込み")
        : Say("written in the paneset", "ペインセットに記述");

    private IJSObjectReference? module;
    private IJSObjectReference? listener;
    private DotNetObjectReference<App>? self;
    private string? loadedFragment;

    protected override async Task OnInitializedAsync()
    {
        opener = new Opener(Http, Runtime);
        Nav.LocationChanged += OnLocationChanged;
        await LoadAsync(new Uri(Nav.Uri).Fragment);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("document.documentElement.setAttribute", "lang", Code);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fragment.js");
            self = DotNetObjectReference.Create(this);
            listener = await module.InvokeAsync<IJSObjectReference>("listen", self);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        if (listener is not null)
        {
            await listener.InvokeVoidAsync("dispose");
            await listener.DisposeAsync();
        }

        if (module is not null)
        {
            await module.DisposeAsync();
        }

        self?.Dispose();
    }

    [JSInvokable]
    public async Task OnFragmentChanged(string fragment)
    {
        if (await LoadAsync(fragment, fromOutside: true))
        {
            StateHasChanged();
        }
    }

    // A link clicked inside the page goes through Blazor's router rather than the browser.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (await LoadAsync(new Uri(e.Location).Fragment, fromOutside: true))
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// The URL is the only place a position lives, so every render starts from it. Returns
    /// whether anything was loaded; the same fragment reported twice is loaded once.
    /// </summary>
    private async Task<bool> LoadAsync(string fragmentText, bool fromOutside = false)
    {
        fragmentText = fragmentText.TrimStart('#');
        if (fragmentText == loadedFragment)
        {
            return false;
        }

        // A position reached by the back button or a pasted link was not reached by the move
        // this page last made, so what that move did is no longer what is on screen.
        if (fromOutside)
        {
            lastMove = null;
            lastDraws = [];
        }

        loadedFragment = fragmentText;
        loading = false;
        error = null;
        ClearRejection();
        copied = false;
        session = null;
        view = null;
        viewSource = null;
        paneSource = null;
        gallery = [];
        themeSource = null;
        theme = null;

        var fragment = Fragment.Parse(fragmentText);
        link = fragment;
        if (!fragment.ContainsKey("r") && !fragment.ContainsKey("p"))
        {
            source = null;
            return true;
        }

        try
        {
            opened = await opener.OpenAsync(fragment);
            (linked, paneSource, source, viewSource, themeSource, view, theme, session) =
                (opened.Linked, opened.PaneSource, opened.Rules, opened.ViewSource, opened.ThemeSource, opened.View, opened.Theme, opened.Session);
            gallery = [.. opened.Gallery];
            terminal = session.Terminal;
            ValidInputSet? valid = terminal.IsTerminal ? null : session.ValidInputs();
            moves = valid?.ToList();
            truncated = valid?.Truncated ?? false;
            projections = session.Context.Projections.ToDictionary(name => name, session.Project);
        }
        catch (Exception e)
        {
            opened = null;
            session = null;
            view = null;
            error = (e.GetType().Name, e.Message);
        }

        return true;
    }

    private async Task Play(ValidInput move, IReadOnlyDictionary<string, JsonNode?>? open)
    {
        if (session is null || source is null)
        {
            return;
        }

        string next;
        try
        {
            Outcome outcome = session.Apply(move, open);
            lastMove = Names.Describe(move, open);
            lastDraws = [.. outcome.Draws];
            next = FragmentFor(Session.PackData(outcome.Result.State));
        }
        catch (InputRejectedException e)
        {
            // A refusal about one parameter belongs under its field; the rest go under the moves.
            refused = move;
            refusals = e.Rejections
                .Where(r => r.Parameter is not null)
                .GroupBy(r => r.Parameter!)
                .ToDictionary(g => g.Key, g => g.Select(r => r.Code).ToArray());
            var rest = e.Rejections.Where(r => r.Parameter is null).Select(r => r.Code).Concat(e.Unexplained).ToList();
            rejection = rest.Count > 0 ? rest : null;
            return;
        }
        catch (Exception e)
        {
            ClearRejection();
            rejection = [e.Message];
            return;
        }

        await GoAsync(next);
    }

    private void ClearRejection()
    {
        refused = null;
        refusals = null;
        rejection = null;
    }

    private async Task Restart()
    {
        lastMove = null;
        lastDraws = [];
        await GoAsync(FragmentFor(null));
    }

    // Loaded here rather than on the event that follows, so the screen never waits on it.
    private async Task GoAsync(string fragment)
    {
        await LoadAsync(fragment);
        if (module is not null)
        {
            await module.InvokeVoidAsync("go", fragment);
        }
    }

    private async Task CopyLink()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", BaseUri + "#" + loadedFragment);
        copied = true;
    }

    private async Task CopyError()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"{error!.Value.Type}\n{error.Value.Message}\n{BaseUri}#{loadedFragment}");
        copied = true;
    }

    // The link as it was, with only the position changed: what it named stays named, and a
    // paneset stays the ground its own keys go over. Without a position, the paneset's start.
    private string FragmentFor(string? packedData) =>
        Fragment.Build(("p", link.GetValueOrDefault("p")), ("r", link.GetValueOrDefault("r")), ("v", link.GetValueOrDefault("v")),
            ("t", link.GetValueOrDefault("t")), ("b", link.GetValueOrDefault("b")), ("s", packedData));
}
