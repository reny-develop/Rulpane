@using System.Text.Json.Nodes
@using Rulealize
@*
    Every move the rules allow right now, and nothing to say which is better: a rule set does not
    rank its moves, so neither does the screen. Moves are grouped by whose they are, then by input.
*@

<section class="card moves @(Side ? "side" : null)">
    <div class="card-head">
        <h2>@Title</h2>
        <span class="meta">@Say($"{Moves.Count} available", $"{Moves.Count} 件")</span>
    </div>
    <div class="moves-body">
        @if (Moves.Count == 0)
        {
            <p class="muted">@Say("No moves are available right now.", "いまできる操作はありません。")</p>
        }
        @foreach (var block in Moves.GroupBy(m => m.Actor))
        {
            <div class="block">
                @if (block.Key is not null)
                {
                    <div class="actor-head"><span class="chip accent"><Icon Name="user" Size="12" />@Names.Value(block.Key)</span> @Say("to act", "の番")</div>
                }

                @{ var inputs = block.GroupBy(m => m.Input).ToList(); }
                @if (inputs.Where(IsPlain).ToList() is { Count: > 0 } plain)
                {
                    <div class="buttons">
                        @foreach (ValidInput move in plain.SelectMany(g => g))
                        {
                            <button class="move" @onclick="() => OnPlay.InvokeAsync((move, null))">@Names.Input(move.Input)</button>
                        }
                    </div>
                }
                @foreach (var input in inputs.Where(g => !IsPlain(g)))
                {
                    <div class="input-group">
                        <div class="input-head">
                            @Names.Input(input.Key)
                            @if (input.First().Arguments is { IsEmpty: false } arguments)
                            {
                                <span class="params">· @string.Join(", ", arguments.Select(a => Names.Param(a.Key)))</span>
                            }
                        </div>
                        @if (Select && input.Where(m => m.IsComplete).ToList() is { Count: > 0 } complete)
                        {
                            @* One list of the input's choices and one button to play the one picked; the order is the rules'. *@
                            <div class="move-select">
                                <select value="@Picked(input.Key, complete)" @onchange="e => picked[input.Key] = e.Value?.ToString() ?? string.Empty"
                                        aria-label="@Names.Input(input.Key)">
                                    <option value="" disabled>@Say("Choose…", "選んでください…")</option>
                                    @foreach (var (move, i) in complete.Select((m, i) => (m, i)))
                                    {
                                        <option value="@i">@ArgumentLabel(move)</option>
                                    }
                                </select>
                                <button class="move" disabled="@(Picked(input.Key, complete) == string.Empty)"
                                        @onclick="() => OnPlay.InvokeAsync((complete[int.Parse(Picked(input.Key, complete))], null))">@Names.Input(input.Key)</button>
                            </div>
                        }
                        @if (input.Where(m => !Select && m.IsComplete).ToList() is { Count: > 0 } buttons)
                        {
                            <div class="buttons">
                                @foreach (ValidInput move in buttons)
                                {
                                    <button class="move" @onclick="() => OnPlay.InvokeAsync((move, null))">@ArgumentLabel(move)</button>
                                }
                            </div>
                        }
                        @if (input.Where(m => !m.IsComplete).ToList() is { Count: > 0 } open)
                        {
                            @* Keyed by the moves, so a form left behind by the last position starts empty. *@
                            <MoveForm @key="@string.Join(" | ", open.Select(m => Names.Describe(m)))" Moves="open" Label="ArgumentLabel" Names="Names"
                                      Refusals="@(open.Any(m => ReferenceEquals(m, Refused)) ? Refusals : null)"
                                      OnSubmit="p => OnPlay.InvokeAsync((p.Move, p.Open))" />
                        }
                    </div>
                }
            </div>
        }
        @if (Truncated)
        {
            <p class="muted">@Say($"Too many candidates: the list stops at {Session.ValidationLimit}.", $"候補が多すぎるため、{Session.ValidationLimit} 個で打ち切っています。")</p>
        }
        @if (Rejection is not null)
        {
            <p class="rejection"><Icon Name="alert" Size="14" />
                @foreach (var (refusal, i) in Rejection.Select((r, i) => (r, i)))
                {
                    @(i > 0 ? " / " : null)<Refusal Code="@refusal" Names="Names" />
                }
            </p>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyCollection<ValidInput> Moves { get; set; } = default!;

    /// <summary>Whether the search stopped at the limit, so <see cref="Moves"/> is not all of them.</summary>
    [Parameter] public bool Truncated { get; set; }

    [Parameter] public string Title { get; set; } = Say("Moves", "操作");

    /// <summary>Whether this is the column beside the view, which a wide screen keeps in sight.</summary>
    [Parameter] public bool Side { get; set; } = true;

    /// <summary>A move chosen, with the values typed for its open parameters when it has any.</summary>
    [Parameter] public EventCallback<(ValidInput Move, IReadOnlyDictionary<string, JsonNode?>? Open)> OnPlay { get; set; }

    /// <summary>The move the rules last refused, whose form shows <see cref="Refusals"/>.</summary>
    [Parameter] public ValidInput? Refused { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string[]>? Refusals { get; set; }

    /// <summary>What the rules said that no single field of a form is the place for.</summary>
    [Parameter] public IReadOnlyList<string>? Rejection { get; set; }

    /// <summary>What the view calls the inputs, parameters, values and codes shown here.</summary>
    [Parameter] public Names Names { get; set; } = Names.None;

    /// <summary>Whether an input's choices are a list to pick from, rather than a button each.</summary>
    [Parameter] public bool Select { get; set; }

    // What is picked in each input's list, by input; a new position starts every list unpicked.
    private readonly Dictionary<string, string> picked = new();
    private string? pickedFor;

    // The moves arrive as a new list on every render, so a new position is told apart by what they are.
    protected override void OnParametersSet()
    {
        string position = string.Join('\n', Moves.Select(m => Names.Describe(m)));
        if (position != pickedFor)
        {
            picked.Clear();
            pickedFor = position;
        }
    }

    private string Picked(string input, List<ValidInput> choices) =>
        picked.TryGetValue(input, out string? i) && int.TryParse(i, out int n) && n < choices.Count ? i : string.Empty;

    // An input with nothing to choose is one button named after it.
    private static bool IsPlain(IGrouping<string, ValidInput> input) =>
        input.All(m => m.IsComplete && m.Arguments.IsEmpty);

    private string ArgumentLabel(ValidInput move)
    {
        if (move.Arguments.IsEmpty)
        {
            return Names.Input(move.Input);
        }

        // The parameter names are in the group's heading, so a lone argument is its value alone.
        return move.Arguments.Count() == 1
            ? Names.Rendered(move.Arguments.First().Value)
            : string.Join(", ", move.Arguments.Select(a => $"{Names.Param(a.Key)}: {Names.Rendered(a.Value)}"));
    }
}
