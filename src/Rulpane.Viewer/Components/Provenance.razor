@using System.Text.Json
@using System.Text.Json.Nodes
@*
    Who made the screen, said in the bar on every screen that came in a link. The sentence is
    always there, so nobody has to open anything to learn it; the button only adds the detail.
*@

<div class="provenance">
    <button class="provenance-button @(open ? "open" : null)" @onclick="Toggle" aria-expanded="@open" aria-controls="provenance-details">
        <Icon Name="shield" Size="14" />
        <span class="long">@Say($"{(InLink ? "Made by the link's author" : "Published by others")}, not by Rulpane. Rulpane never asks for passwords or payment.",
                                 $"Rulpane ではなく、{(InLink ? "リンクの作者が作ったもの" : "他の人が公開したもの")}です。Rulpane はパスワードや支払いを求めません。")</span>
        @* Two lines set by hand, so the button is only as wide as the longer of them. *@
        <span class="short"><span>@Say($"{(InLink ? "Made by the link's author" : "Published by others")}, not Rulpane.", $"Rulpane ではなく{(InLink ? "リンクの作者が作成" : "他の人が公開")}。")</span><span>@Say("Rulpane never asks for passwords.", "Rulpane はパスワードを求めません。")</span></span>
        <Icon Name="info" Size="14" />
    </button>

    @if (open)
    {
        <div class="provenance-scrim" @onclick="Close"></div>
        <section id="provenance-details" class="provenance-details" role="dialog" aria-labelledby="provenance-title">
            <span class="grabber" aria-hidden="true"></span>
            <div class="details-head">
                <span class="badge"><Icon Name="shield" Size="16" /></span>
                <h2 id="provenance-title">@Say("About this screen", "この画面について")</h2>
            </div>
            <div class="details-section">
                <h3>@Say("Who made it", "誰が作ったか")</h3>
                @if (InLink)
                {
                    <p>@Say("Whoever made this link. The rules, the layout and the look travel inside the link itself, and Rulpane runs them without checking who wrote them.", "このリンクを作った人です。ルール、レイアウト、見た目はリンクそのものに入っていて、Rulpane は誰が書いたかを確かめずに動かしています。")</p>
                }
                @if (Published.Count > 0)
                {
                    <p>@Say($"{(InLink ? "The link also names" : "The link names")} rules published to the Rulealize Registry: {string.Join(", ", Published)}. Whoever published them wrote them. The Registry checks that a package is the one it says it is, and nobody reviews what its rules do.",
                           $"このリンクは{(InLink ? "ほかに、" : "")} Rulealize Registry に公開されたルールを指しています：{string.Join("、", Published)}。書いたのは公開した人です。Registry はパッケージが名乗りどおりのものかを確かめますが、ルールの中身を審査する人はいません。")</p>
                }
            </div>
            <div class="details-section">
                <h3>@Say("What Rulpane makes sure of", "Rulpane が保証すること")</h3>
                <p>@Say("A link can only arrange the rules' values and moves and choose their colours, and Rulpane refuses colours that are hard to read. It cannot run scripts of its own, and it cannot change this bar.", "リンクで決められるのは、ルールの値や操作ボタンを画面のどこに置くかと、その色だけです。読みにくい配色は Rulpane が受け付けません。リンクが独自のスクリプトを動かすことはできず、この上部バーもリンクからは変えられません。")</p>
            </div>
            <div class="details-section watch">
                <h3>@Say("What to watch for", "気をつけること")</h3>
                <p>@Say("Rulpane never asks for passwords, payment or personal details. If this screen does, close it.", "Rulpane がパスワード、支払い、個人情報を求めることはありません。この画面が求めてきたら、閉じてください。")</p>
                <p>@Say("Names, logos and wording on the screen are typed by the link's author. Anyone can type them.", "画面にある名前、ロゴ、文言は、リンクの作者が入力したものです。誰でも入力できます。")</p>
            </div>
            @if (showing)
            {
                @foreach (var (name, text) in Documents)
                {
                    <div class="details-document">
                        <h3>@name</h3>
                        <pre>@Indent(text)</pre>
                    </div>
                }
            }
            <div class="details-actions">
                <button @onclick="() => showing = !showing">@(showing ? Say("Hide the rules", "ルールを隠す") : Say("View the rules", "ルールを見る"))</button>
                <button class="primary" @onclick="Close">@Say("Got it", "わかりました")</button>
            </div>
        </section>
    }
</div>

@code {
    /// <summary>The documents the screen is made from, by what they are, as they arrived.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<(string Name, string Text)> Documents { get; set; } = default!;

    /// <summary>The rule sets from the Registry the screen runs, each as its identifier and version.</summary>
    [Parameter] public IReadOnlyList<string> Published { get; set; } = [];

    /// <summary>Whether any document was written into the link itself, rather than only named by it.</summary>
    [Parameter] public bool InLink { get; set; } = true;

    private bool open;
    private bool showing;

    private void Toggle()
    {
        open = !open;
        showing = false;
    }

    private void Close()
    {
        open = false;
        showing = false;
    }

    // A document from a link is minified; indented, a person can read it. Comments are not kept.
    private static string Indent(string text)
    {
        try
        {
            return JsonNode.Parse(text, documentOptions: new JsonDocumentOptions
            {
                CommentHandling = JsonCommentHandling.Skip,
                AllowTrailingCommas = true,
            })!.ToJsonString(new JsonSerializerOptions
            {
                WriteIndented = true,
                // Shown as text, never as markup, so the author's own characters can stay as typed.
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
            });
        }
        catch (JsonException)
        {
            return text;
        }
    }
}
