@using System.Text.Json.Nodes
@using Rulealize
@using Rulealize.Abstraction.Value
@* An input's moves still waiting for values nobody enumerated — typed by the person in front of
   the screen. Moves that differ only in the arguments their domains gave are one form, those
   arguments a list to pick from, so the values to type are asked for once. *@

<form class="move-form" @onsubmit="Submit">
    @if (Moves.Count > 1)
    {
        <label class="field">
            <span class="label">@string.Join(", ", Move.Arguments.Select(a => Names.Param(a.Key)))</span>
            <select @bind="choice">
                <option value="" disabled>@Say("Choose…", "選んでください…")</option>
                @foreach (var (move, i) in Moves.Select((m, i) => (m, i)))
                {
                    <option value="@i">@Label(move)</option>
                }
            </select>
        </label>
    }
    @foreach (OpenParameter parameter in Move.Open)
    {
        string[] codes = Refusals?.GetValueOrDefault(parameter.Name) ?? [];
        <label class="field @(codes.Length > 0 ? "invalid" : null)">
            <span class="label">@Names.Param(parameter.Name) <span class="chip">@Kind(parameter)</span></span>
            @if (Choices(parameter) is string[] choices)
            {
                @* The schema lists every value it admits, so the screen offers them rather than asking for one to be typed. *@
                <select @bind="values[parameter.Name]" aria-invalid="@(codes.Length > 0)">
                    <option value="" disabled>@Say("Choose…", "選んでください…")</option>
                    @foreach (string choice in choices)
                    {
                        <option value="@choice">@Names.Value(choice)</option>
                    }
                </select>
            }
            else
            {
                <input @bind="values[parameter.Name]" placeholder="@Kind(parameter)" aria-invalid="@(codes.Length > 0)" />
            }
            @foreach (string refusal in codes)
            {
                <span class="rejection"><Icon Name="alert" Size="14" /><Refusal Code="@refusal" Names="Names" Suffix="@Say(" refused by the rules", " はルールに拒否されました")" /></span>
            }
            @if (parameter.Description is { Fields.Count: > 0 } bounds && Choices(parameter) is null)
            {
                <small>@Bounds(bounds)</small>
            }
        </label>
    }
    <div>
        <button type="submit" class="primary move" disabled="@(Picked is null)"><Icon Name="arrow" />@(Moves.Count > 1 ? Names.Input(Move.Input) : Label(Move))</button>
    </div>
</form>

@code {
    /// <summary>One input's moves, all with the same parameters left open.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ValidInput> Moves { get; set; } = default!;

    /// <summary>What to call a move by the arguments its domains gave.</summary>
    [Parameter, EditorRequired] public Func<ValidInput, string> Label { get; set; } = default!;
    [Parameter] public Names Names { get; set; } = Names.None;
    [Parameter] public EventCallback<(ValidInput Move, IReadOnlyDictionary<string, JsonNode?> Open)> OnSubmit { get; set; }

    /// <summary>The codes the rules answered the last attempt with, by the parameter they are about.</summary>
    [Parameter] public IReadOnlyDictionary<string, string[]>? Refusals { get; set; }

    private readonly Dictionary<string, string> values = new();
    private string choice = "";

    // The one picked from the list, or the only one there is.
    private ValidInput? Picked =>
        Moves.Count == 1 ? Moves[0] : int.TryParse(choice, out int i) && i < Moves.Count ? Moves[i] : null;

    // The open parameters are the input's, the same for each of its moves.
    private ValidInput Move => Picked ?? Moves[0];

    protected override void OnParametersSet()
    {
        foreach (OpenParameter parameter in Move.Open)
        {
            values.TryAdd(parameter.Name, "");
        }
    }

    private Task Submit()
    {
        if (Picked is not ValidInput move)
        {
            return Task.CompletedTask;
        }

        var typed = move.Open.ToDictionary(p => p.Name, p => (JsonNode?)Convert(p, values[p.Name]));
        return OnSubmit.InvokeAsync((move, typed));
    }

    // An enumeration declares its values among its bounds; null for a parameter that lists none.
    private static string[]? Choices(OpenParameter parameter) =>
        parameter.Op == "type.enum" && parameter.Description.Fields.FirstOrDefault(f => f.Key == "values").Value is SequenceValue values
            ? values.Select(v => v.GetCanonicalText() ?? "").ToArray()
            : null;

    // The bounds as the document writes them: "min 1 · max 100000".
    private static string Bounds(RecordValue bounds) =>
        string.Join(" · ", bounds.Fields.Select(f => $"{f.Key} {Bound(f.Value)}"));

    // A list or a record has no canonical text of its own, so each is written out from its parts: "values a, b".
    private static string Bound(RuleValue value) => value switch
    {
        SequenceValue items => string.Join(", ", items.Select(Bound)),
        RecordValue record => "{" + string.Join(", ", record.Fields.Select(f => $"{f.Key}: {Bound(f.Value)}")) + "}",
        _ => Display.Unquote(value.GetCanonicalText() ?? "null"),
    };

    // The schema node's name without its plugin, which is all a person filling it in needs.
    private static string Kind(OpenParameter parameter) => parameter.Op switch
    {
        null => "value",
        string op when op.StartsWith("type.", StringComparison.Ordinal) => op["type.".Length..],
        string op => op,
    };

    // The admitting schema node says what kind of value it takes; anything else is text.
    private static JsonNode Convert(OpenParameter parameter, string text) => parameter.Op switch
    {
        "type.int" when long.TryParse(text, out long i) => JsonValue.Create(i),
        "type.number" when double.TryParse(text, out double d) => JsonValue.Create(d),
        "type.bool" when bool.TryParse(text, out bool b) => JsonValue.Create(b),
        _ => JsonValue.Create(text),
    };
}
