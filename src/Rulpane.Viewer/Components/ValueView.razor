@using System.Text.Json
@using System.Text.Json.Nodes
@* A value a rule set answered with, shown by its shape alone: nothing here knows what it means. *@

@switch (Value)
{
    case null:
        <span class="null">—</span>
        break;
    case JsonObject record when record.Count == 0:
        <span class="null">{}</span>
        break;
    case JsonObject record:
        <dl class="record">
            @foreach (var (key, item) in record)
            {
                <dt>@key</dt>
                <dd><ValueView Value="item" /></dd>
            }
        </dl>
        break;
    case JsonArray sequence when sequence.Count == 0:
        <span class="null">[]</span>
        break;
    case JsonArray sequence:
        <ol class="sequence">
            @foreach (var item in sequence)
            {
                <li><ValueView Value="item" /></li>
            }
        </ol>
        break;
    case JsonValue scalar when scalar.GetValueKind() == JsonValueKind.True:
        <span class="bool yes">true</span>
        break;
    case JsonValue scalar when scalar.GetValueKind() == JsonValueKind.False:
        <span class="bool no">false</span>
        break;
    case JsonValue scalar when scalar.GetValueKind() == JsonValueKind.String:
        <span class="text">@(scalar.GetValue<string>())</span>
        break;
    default:
        <span class="number">@Value.ToJsonString()</span>
        break;
}

@code {
    [Parameter] public JsonNode? Value { get; set; }
}
