@using System.Text.Json
@using System.Text.Json.Nodes
@using Rulealize
@*
    A Grid board, drawn square by square. A square is a button only when the rules offer exactly
    one move of the board's input on it; which squares those are is the rules' answer, not the board's.
    A board moved on from one square to another takes two: a square a move starts from, then one
    of the squares that move goes to.
*@

<section class="card board-card @(Board.Keys ? "keys-card" : null)">
    @if (Board.Title is not null)
    {
        <div class="card-head"><h2>@Board.Title</h2></div>
    }
    @if (Board.Readout is KeyDisplay display)
    {
        <div class="key-display" role="status">
            <span class="key-display-above">@Above(display)</span>
            <span class="key-display-value">@Written(DisplayRead(display.Bind), display.Format)</span>
        </div>
    }
    <div class="board @(Board.Checkered ? "checkered" : null) @(Board.Keys ? "keys" : null)" style="--files: @Shape.Width">
        @if (!Board.Keys)
        {
            <span></span>
            @for (int x = 0; x < Shape.Width; x++)
            {
                <span class="board-label">@Shape.File(x)</span>
            }
        }
        @for (int row = 0; row < Shape.Height; row++)
        {
            @if (!Board.Keys)
            {
                <span class="board-label">@Shape.Rank(row)</span>
            }
            @for (int x = 0; x < Shape.Width; x++)
            {
                string coord = Shape.Coord(x, row);
                string? text = Value is JsonObject squares && squares[coord] is JsonNode cell ? Text(cell) : null;
                string shade = Board.Checkered && (x + row) % 2 == 1 ? "dark" : "";
                if (Board.Keys)
                {
                    @* A key is named by what is on it; one the rules do not offer now stays, and cannot be pressed. *@
                    string? tone = text is not null && Board.Tones?.TryGetValue(text, out Tone t) == true ? $"tone-{t}" : null;
                    if (text is null)
                    {
                        <span class="square key empty"></span>
                    }
                    else if (MoveOn(coord) is ValidInput press)
                    {
                        <button class="square key @tone" aria-label="@Names.Value(text)" title="@Names.Describe(press)"
                                @onclick="() => OnPlay.InvokeAsync((press, null))">
                            <span class="square-text">@Names.Value(text)</span>
                        </button>
                    }
                    else
                    {
                        <button class="square key @tone" disabled aria-label="@Names.Value(text)">
                            <span class="square-text">@Names.Value(text)</span>
                        </button>
                    }
                }
                else if (MoveOn(coord) is ValidInput move)
                {
                    <button class="square playable @shade" title="@Names.Describe(move)" aria-label="@($"{Names.Input(Board.Play!.Input)} {coord}")"
                            @onclick="() => OnPlay.InvokeAsync((move, null))">
                        <Square Text="@text" Pieces="Board.Pieces" Names="Names" />
                    </button>
                }
                else if (selected is not null && coord == selected)
                {
                    <button class="square selected @shade" aria-pressed="true" aria-label="@($"{coord}: {Say("chosen; choose again to put it back", "選択中。もう一度押すと戻します")}")"
                            @onclick="() => Choose(null)">
                        <Square Text="@text" Pieces="Board.Pieces" Names="Names" />
                    </button>
                }
                else if (selected is not null && Destinations.Contains(coord))
                {
                    <button class="square playable @(text is null ? null : "target") @shade" aria-label="@($"{Names.Input(Board.Move!.Input)} {selected} → {coord}")"
                            @onclick="() => Land(coord)">
                        <Square Text="@text" Pieces="Board.Pieces" Names="Names" />
                    </button>
                }
                else if (Origins.Contains(coord))
                {
                    <button class="square origin @shade" aria-label="@($"{coord}: {(text is null ? Say("empty", "空き") : Names.Value(text))}")"
                            @onclick="() => Choose(coord)">
                        <Square Text="@text" Pieces="Board.Pieces" Names="Names" />
                    </button>
                }
                else
                {
                    <span class="square @shade" aria-label="@($"{coord}: {(text is null ? Say("empty", "空き") : Names.Value(text))}")">
                        <Square Text="@text" Pieces="Board.Pieces" Names="Names" />
                    </span>
                }
            }
        }
    </div>
    @if (choices is not null)
    {
        <div class="board-choices">
            @foreach (ValidInput choice in choices)
            {
                <button class="move" @onclick="() => Play(choice)">@Names.Rendered(choice.Arguments[Board.Move!.Parameter])</button>
            }
        </div>
    }
    @if (Rejection is not null && (Refused?.Input == Board.Play?.Input || Refused?.Input == Board.Move?.Input))
    {
        <p class="rejection board-rejection"><Icon Name="alert" Size="14" />
            @foreach (var (refusal, i) in Rejection.Select((r, i) => (r, i)))
            {
                @(i > 0 ? " / " : null)<Refusal Code="@refusal" Names="Names" />
            }
        </p>
    }
</section>

@code {
    [Parameter, EditorRequired] public Board Board { get; set; } = default!;

    /// <summary>The board as the state holds it: an object of the squares that have something on them.</summary>
    [Parameter] public JsonNode? Value { get; set; }

    /// <summary>The moves the rules allow; null once they have ended, when no square is played.</summary>
    [Parameter] public IReadOnlyCollection<ValidInput>? Moves { get; set; }

    [Parameter] public EventCallback<(ValidInput Move, IReadOnlyDictionary<string, JsonNode?>? Open)> OnPlay { get; set; }
    [Parameter] public ValidInput? Refused { get; set; }
    [Parameter] public IReadOnlyList<string>? Rejection { get; set; }
    [Parameter] public Names Names { get; set; } = Names.None;

    /// <summary>Reads a binding of the view, for the readout over a board of keys.</summary>
    [Parameter] public Func<Binding, JsonNode?>? Read { get; set; }

    private BoardShape Shape => Board.Shape;

    private JsonNode? DisplayRead(Binding binding) => Read?.Invoke(binding);

    // A value as the readout shows it: a number written to the format, text by the name the view gives it.
    private string Written(JsonNode? value, Format? format) => value switch
    {
        null => "",
        JsonValue v when v.GetValueKind() == JsonValueKind.String => Names.Value(v.GetValue<string>()),
        JsonValue v when v.GetValueKind() == JsonValueKind.Number => (format ?? Plain).Write(v)!,
        _ => value.ToJsonString(),
    };

    private static readonly Format Plain = new(null, 1, "", "");

    // What is over the readout: a value, or a list of them one after another.
    private string Above(KeyDisplay display) => display.Above is null ? "" : DisplayRead(display.Above) switch
    {
        JsonArray list => string.Join(" ", list.Select(v => Written(v, display.Format))),
        JsonNode value => Written(value, display.Format),
        null => "",
    };

    private IReadOnlyDictionary<string, ValidInput> squareMoves = new Dictionary<string, ValidInput>();
    private IReadOnlyList<(string From, string To, ValidInput Move)> pairs = [];
    private IReadOnlyCollection<ValidInput>? seen;

    // The square chosen to move from, and the moves to pick between when two land on the same square.
    private string? selected;
    private List<ValidInput>? choices;

    protected override void OnParametersSet()
    {
        squareMoves = Board.SquareMoves(Moves);
        pairs = Board.SquarePairs(Moves);
        if (!ReferenceEquals(seen, Moves))
        {
            seen = Moves;
            selected = null;
            choices = null;
        }
    }

    private ValidInput? MoveOn(string coord) => squareMoves.GetValueOrDefault(coord);

    private HashSet<string> Origins => [.. pairs.Select(p => p.From)];

    private HashSet<string> Destinations => [.. pairs.Where(p => p.From == selected).Select(p => p.To)];

    private void Choose(string? from)
    {
        selected = from;
        choices = null;
    }

    private async Task Land(string to)
    {
        var landing = pairs.Where(p => p.From == selected && p.To == to).Select(p => p.Move).ToList();
        if (landing.Count == 1)
        {
            await Play(landing[0]);
        }
        else
        {
            choices = landing;
        }
    }

    private async Task Play(ValidInput move)
    {
        selected = null;
        choices = null;
        await OnPlay.InvokeAsync((move, null));
    }

    private static string Text(JsonNode cell) =>
        cell is JsonValue v && v.GetValueKind() == JsonValueKind.String ? v.GetValue<string>() : cell.ToJsonString();
}
