@using System.Text.Json
@using System.Text.Json.Nodes
@using Rulealize
@* A screen laid out by a view document. Everything shown is read through a binding; nothing here decides anything. *@

<div class="layout">
    @foreach (Block block in View.Layout.Where(Shown))
    {
        @switch (block)
        {
            case Heading heading:
                <h2 class="layout-heading">@heading.Text</h2>
                break;
            case Paragraph paragraph:
                <p class="layout-text">@paragraph.Body</p>
                break;
            case Fields fields:
                <section class="card">
                    @if (fields.Title is not null)
                    {
                        <div class="card-head"><h2>@fields.Title</h2></div>
                    }
                    <dl class="rows labelled">
                        @foreach (Row row in fields.Rows.Where(r => r.ShowWhen is null || IsTrue(r.ShowWhen)))
                        {
                            JsonNode? value = Read(row.Bind);
                            <div>
                                <dt>@row.Label</dt>
                                <dd>
                                    @if (row.Format?.Write(value) is string written)
                                    {
                                        <span class="number">@written</span>
                                    }
                                    else if (row.Tones is not null && value is JsonValue)
                                    {
                                        @* The tone is keyed by the value the rules hold; the chip says what the view calls it. *@
                                        string text = Display.Unquote(value.ToJsonString());
                                        string shown = View.Names.Value(text);
                                        <span class="chip dot @(shown == text ? "mono" : null) @ToneClass(row.Tones.GetValueOrDefault(text))">@shown</span>
                                    }
                                    else
                                    {
                                        <ValueView Value="value" Names="View.Names" />
                                    }
                                </dd>
                            </div>
                        }
                    </dl>
                </section>
                break;
            case Stats stats:
                <div class="stats">
                    @foreach (Stat stat in stats.Items)
                    {
                        <div class="card stat">
                            <span class="stat-label">@stat.Label</span>
                            @if (stat.Format?.Write(Read(stat.Bind)) is string written)
                            {
                                <span class="stat-value number">@written</span>
                            }
                            else
                            {
                                <span class="stat-value">@Scalar(Read(stat.Bind))</span>
                            }
                        </div>
                    }
                </div>
                break;
            case ValueList list:
                <section class="card">
                    @if (list.Title is not null)
                    {
                        <div class="card-head"><h2>@list.Title</h2></div>
                    }
                    @if (Read(list.Bind) is JsonArray { Count: > 0 } values)
                    {
                        <div class="card-body">
                            @if (values.All(v => v is null or JsonValue))
                            {
                                <ol class="chips value-list">
                                    @foreach (JsonNode? value in values)
                                    {
                                        @* Like a toned value, a value the view names is in the text face; one it leaves as the rules spell it stays code. *@
                                        string shown = Scalar(value);
                                        <li class="chip @(value is JsonValue v && v.GetValueKind() == JsonValueKind.String && shown != v.GetValue<string>() ? "named" : null)">@shown</li>
                                    }
                                </ol>
                            }
                            else
                            {
                                <ValueView Value="values" Names="View.Names" />
                            }
                        </div>
                    }
                    else
                    {
                        <p class="card-body muted">@Say("Nothing to list.", "表示するものがありません。")</p>
                    }
                </section>
                break;
            case Table table:
                <section class="card">
                    @if (table.Title is not null)
                    {
                        <div class="card-head"><h2>@table.Title</h2></div>
                    }
                    @if (Read(table.Bind) is JsonArray { Count: > 0 } items)
                    {
                        IReadOnlyList<Column> columns = table.Columns ?? KeysOf(items);
                        <div class="table-scroll">
                            <table class="table">
                                <thead>
                                    <tr>
                                        @foreach (Column column in columns)
                                        {
                                            <th class="@(column.Format is null ? null : "number")">@column.Label</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (JsonNode? item in items)
                                    {
                                        <tr>
                                            @foreach (Column column in columns)
                                            {
                                                JsonNode? cell = item is JsonObject record ? record[column.Key] : null;
                                                if (column.Format?.Write(cell) is string written)
                                                {
                                                    <td class="number">@written</td>
                                                }
                                                else
                                                {
                                                    <td><ValueView Value="cell" Names="View.Names" /></td>
                                                }
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="card-body muted">@Say("Nothing to list.", "表示するものがありません。")</p>
                    }
                </section>
                break;
            case Chart chart:
                <ChartView Chart="chart" Items="@(Read(chart.Bind) as JsonArray)" Names="View.Names" />
                break;
            case Board board:
                <BoardView Board="board" Value="@Read(board.Bind)" Moves="Moves" OnPlay="OnPlay" Refused="Refused" Rejection="Rejection" Names="View.Names" />
                break;
            @*
                Moves of named inputs that none of are available now leave nothing to show. "*" always
                says so, unless every move there is is already a square of a board on screen.
            *@
            case Actions actions when Moves is not null && (Offered(actions).Count > 0 || actions.Inputs is null && OnBoards.Count == 0):
                <MovePanel Moves="@Offered(actions)" Truncated="Truncated" Title="@(actions.Title ?? Say("Moves", "操作"))" Side="false" Select="actions.Select"
                           OnPlay="OnPlay" Refused="Refused" Refusals="Refusals" Rejection="Rejection" Names="View.Names" Initial="Filled(actions)" />
                break;
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public View View { get; set; } = default!;

    /// <summary>Every projection by name, already answered for this position.</summary>
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, JsonNode?> Projections { get; set; } = default!;

    /// <summary>The state's <c>data</c>, which a <c>$</c> binding reads.</summary>
    [Parameter] public JsonNode? Data { get; set; }

    /// <summary>The moves the rules allow; null once they have ended, when no actions block is shown.</summary>
    [Parameter] public IReadOnlyCollection<ValidInput>? Moves { get; set; }
    [Parameter] public bool Truncated { get; set; }

    [Parameter] public EventCallback<(ValidInput Move, IReadOnlyDictionary<string, JsonNode?>? Open)> OnPlay { get; set; }
    [Parameter] public ValidInput? Refused { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string[]>? Refusals { get; set; }
    [Parameter] public IReadOnlyList<string>? Rejection { get; set; }

    private JsonNode? Read(Binding binding) => binding.Read(name => Projections.GetValueOrDefault(name), Data);

    // Only a true value shows a block: the rules say when, so anything that is not a plain yes is a no.
    private bool IsTrue(Binding binding) => Read(binding) is JsonValue v && v.GetValueKind() == JsonValueKind.True;

    private bool Shown(Block block) => block.ShowWhen is null || IsTrue(block.ShowWhen);

    // "*" is every move a board on screen does not already offer as a square; a list of inputs is all of theirs.
    private List<ValidInput> Offered(Actions actions) =>
        Moves!.Where(m => actions.Inputs is null ? !OnBoards.Contains(m) : actions.Inputs.Contains(m.Input)).ToList();

    private HashSet<ValidInput> OnBoards => [.. View.Layout.OfType<Board>().Where(Shown).SelectMany(b => b.Offered(Moves))];

    // What each field a fill names starts with: the value as it would be typed, so a number stays digits.
    private Dictionary<string, string>? Filled(Actions actions) =>
        actions.Fill?.ToDictionary(f => f.Key, f => Read(f.Value) switch
        {
            null => "",
            JsonValue v when v.GetValueKind() == JsonValueKind.String => v.GetValue<string>(),
            JsonNode other => other.ToJsonString(),
        });

    private static string? ToneClass(Tone tone) => tone == Tone.neutral ? null : tone.ToString();

    private string Scalar(JsonNode? node) => node switch
    {
        null => "—",
        JsonValue v when v.GetValueKind() == JsonValueKind.String => View.Names.Value(v.GetValue<string>()),
        _ => node.ToJsonString(),
    };

    // A table with no columns named shows every key, in the order they first appear.
    private static List<Column> KeysOf(JsonArray items) =>
        items.OfType<JsonObject>().SelectMany(r => r.Select(p => p.Key)).Distinct().Select(k => new Column(k, k)).ToList();
}
