@using System.Text.Json
@using System.Text.Json.Nodes
@using Rulealize
@inject HttpClient Http
@inject IJSRuntime JS
@* What a link with nothing in it shows: what Rulpane is for, a request to give an AI, the panesets
   to start from, and the editor. How to write one follows, outside the app, in index.html: it is
   there for anybody — or any AI — that reads the page without running it. *@

<div class="landing">
    <section class="hero">
        <div class="hero-copy">
            <span class="chip accent">@Say("No server · it all runs in your browser", "サーバーなし · すべてブラウザの中で動きます")</span>
            <h1>@Say("Make a simple system", "リンク１つで")<br />@Say("from one link.", "簡易システムを作る。")</h1>
            <p>
                @Say("Say what can be done and when it is finished, and Rulpane makes it a screen that runs from one link. Records, tallies, checklists, games played in turns — anything you can put as rules. Where things stand is in the link too: bookmark it to carry on later, or send it on and the next person carries on from there.",
                     "何ができて、どうなったら終わるのか。その決まりを書けば、Rulpane がリンク 1 つで使える画面にします。記録や集計、チェックリスト、交代で進めるゲームなど、決まりとして書けるものなら作れます。状態もリンクに入るので、ブックマークすれば続きから、人に送ればその人が続きから使えます。")
            </p>
        </div>

        <div id="ask" class="card ask">
            <h2>@Say("Ask an AI to make one", "AI に作ってもらう")</h2>
            <input @ref="needInput" @bind="need" @bind:event="oninput" spellcheck="false"
                   placeholder="@Say("What do you need? e.g. a compound growth simulator for monthly investing", "何が要りますか？　例：積立投資の複利効果シミュレーション")" />
            <p class="prompt">@Prompt</p>
            <div class="make-row">
                <button class="primary" @onclick="CopyPrompt"><Icon Name="@(promptCopied ? "check" : "copy")" />@(promptCopied ? Say("Copied", "コピーしました") : Say("Copy the request", "依頼文をコピー"))</button>
            </div>
            <p class="note"><Icon Name="back" Size="14" />@Say("Paste it into any AI that can read web pages. If the link it gives does not open, give it the reason the page shows.", "Web ページを読める AI に貼り付けてください。もらったリンクが開かなければ、画面に出た理由を AI に伝えてください。")</p>
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <h2>@Say("Ready to use", "すぐ使えるもの")</h2>
            <p>@Say("Open one and use it. “Edit a copy” puts what it is made of, as JSON, into “Make a link from JSON” below.", "そのまま開いて使えます。「コピーして編集」を押すと、中身の JSON が下の「JSON からリンクを作る」に入ります。")</p>
        </div>
        <ul class="samples">
            @foreach (Start start in Starts)
            {
                <li class="card sample">
                    <a class="sample-head" href="@(BaseUri + Fragment.Build(("p", start.Name)))">@start.Title<Icon Name="arrow" /></a>
                    <p>@start.Description</p>
                    <span class="tags">
                        <button class="chip" @onclick="() => EditCopy(start.Name)">@Say("Edit a copy", "コピーして編集")</button>
                    </span>
                </li>
            }
        </ul>
    </section>

    <section id="make" class="section">
        <div class="section-head">
            <h2>@Say("Make a link from JSON", "JSON からリンクを作る")</h2>
            <p>@Say("Paste a paneset — the rules, the screen, the look and the state in one JSON document — and press “Make link”: it is opened here first, so the link it gives always opens. What an AI wrote can be pasted as it is, or a link.", "ルール・画面・見た目・状態をまとめた JSON（ペインセット）を貼って「リンクを作る」を押すと、開けるか確かめてからリンクにします。AI が書いたものやリンクもそのまま貼れます。")</p>
        </div>
        <div class="card make">
            <textarea @ref="editor" @bind="document" @bind:event="oninput" @bind:after="Edited" rows="14" spellcheck="false"
                      placeholder="@Placeholder"></textarea>
            <div class="make-row">
                <button class="primary" @onclick="Make"><Icon Name="link" />@Say("Make link", "リンクを作る")</button>
                @if (link is not null)
                {
                    <span class="made"><Icon Name="check" /><a href="@link">@Say($"Open {title}", $"{title} を開く")</a><span class="muted">@Say($"· {link.Length} characters", $"· {link.Length} 文字")</span></span>
                    <button class="small" @onclick="CopyLink"><Icon Name="@(linkCopied ? "check" : "copy")" Size="14" />@(linkCopied ? Say("Copied", "コピーしました") : Say("Copy link", "リンクをコピー"))</button>
                }
            </div>
            @if (problem is not null)
            {
                <pre class="problem">@problem</pre>
            }
        </div>
    </section>
</div>

@code {
    private sealed record Start(string Name, string Title, string Description);

    // Each is the Gallery's paneset of that name, with -ja on it for a page in Japanese: a view is
    // written in one language, so each sample is published once in each (from Rulpane.Panes).
    private static readonly Start[] Starts =
    [
        new(Named("split-bill"), Say("Split the bill", "割り勘"), Say("Record who paid for what, and see what each one pays or gets back.", "立て替えた人と金額を記録すると、1 人ずつの払う額・受け取る額が出ます。")),
        new(Named("packing-list"), Say("Packing list", "持ち物チェックリスト"), Say("Add what to take and tick it off as it goes in. Bookmark it for the next trip.", "持ち物を足して、詰めたものからチェック。ブックマークすれば次の旅行でも使えます。")),
        new(Named("scoreboard"), Say("Scoreboard", "点数表"), Say("Enter each player's points, round by round; the totals and the leader show as you go.", "ボウリングやゴルフ、カードゲームの点を入れていくと、合計と首位が出ます。")),
        new(Named("reversi"), Say("Reversi", "リバーシ"), Say("Two players take turns. Each move changes the link, so you can play apart by sending it back and forth.", "2 人で交互に打ちます。打つたびにリンクが変わるので、送り合えば離れていても対戦できます。")),
        new(Named("minesweeper"), Say("Minesweeper", "マインスイーパー"), Say("Ten mines on a 9 × 9 board. The first square you open is never one.", "9 × 9 に地雷が 10 個。最初に開けるマスに地雷はありません。")),
        new(Named("chess"), Say("Chess", "チェス"), Say("Castling, en passant and promotion included. Pick a piece to see where it can go.", "キャスリング、アンパッサン、昇格まで。駒を選ぶと動けるマスが出ます。")),
    ];

    private static string Named(string name) => $"reny-develop/{name}{(Language.Code == "ja" ? "-ja" : "")}@1";

    private static readonly JsonDocumentOptions Lenient = new() { CommentHandling = JsonCommentHandling.Skip, AllowTrailingCommas = true };

    [Parameter, EditorRequired] public string BaseUri { get; set; } = default!;
    [Parameter, EditorRequired] public RuleRuntime Runtime { get; set; } = default!;

    /// <summary>The part of the page the link asked for, as the bar's links do: ask, make or guide.</summary>
    [Parameter] public string? Focus { get; set; }

    private Opener? opener;
    private ElementReference editor;
    private ElementReference needInput;
    private string? focused;
    private string need = "";
    private bool promptCopied;
    private string document = "";
    private string? problem;
    private string? link;
    private string? title;
    private bool linkCopied;

    private string Prompt => Say(
        $"Read {BaseUri} and make me a Rulpane link for: {(string.IsNullOrWhiteSpace(need) ? "…" : need.Trim())}",
        $"{BaseUri} を読んで、次のものを Rulpane のリンクにしてください：{(string.IsNullOrWhiteSpace(need) ? "…" : need.Trim())}");

    private static string Placeholder => """
        {
          "$schema": "rulpane/paneset/v1",
          "r": { "$schema": "rulealize/ruleset/v1", "id": "…", … },
          "v": { "$schema": "rulealize/view/v1", "layout": [ … ] },
          "s": { … }
        }
        """;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Focus != focused)
        {
            focused = Focus;
            switch (Focus)
            {
                case "ask":
                    await needInput.FocusAsync();
                    break;
                case "make":
                    await editor.FocusAsync();
                    break;
                case "guide":
                    await using (IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/fragment.js"))
                    {
                        await module.InvokeVoidAsync("reveal", "guide");
                    }
                    break;
            }
        }
    }

    private async Task CopyPrompt()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Prompt);
        promptCopied = true;
    }

    private async Task CopyLink()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", link);
        linkCopied = true;
    }

    // The paneset with what it names written in place, so the copy shows everything there is to change.
    private async Task EditCopy(string name)
    {
        problem = null;
        link = null;
        JsonObject paneset = JsonNode.Parse(await Source.Paneset(name).ReadAsync(Http), documentOptions: Lenient)!.AsObject();
        foreach (var (key, source) in new (string, Func<string, Source>)[] { ("r", Source.Rules), ("v", Source.View), ("t", Source.Theme) })
        {
            if (paneset[key] is JsonValue named && named.TryGetValue(out string? value) && !value.StartsWith('{') && !value.StartsWith(Fragment.PackedPrefix, StringComparison.Ordinal))
            {
                paneset[key] = JsonNode.Parse(await source(value).ReadAsync(Http), documentOptions: Lenient);
            }
        }

        document = paneset.ToJsonString(new JsonSerializerOptions { WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
        await editor.FocusAsync();
    }

    // A link made from what the editor held before is not one for what it holds now: it goes, and
    // so does a reason that was about the old text, until the link is made again.
    private void Edited()
    {
        link = null;
        problem = null;
        linkCopied = false;
    }

    // Opened here as the link will be, so a link this page hands out is one that opens.
    private async Task Make()
    {
        problem = null;
        link = null;
        linkCopied = false;
        try
        {
            string text = document.Trim();
            string fragment;
            if (text.StartsWith('#') || text.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            {
                int hash = text.IndexOf('#');
                fragment = hash < 0 ? throw new FormatException("The link has no '#', so it names nothing to open.") : text[hash..];
            }
            else
            {
                JsonObject written = JsonNode.Parse(text, documentOptions: Lenient)?.AsObject()
                    ?? throw new FormatException("Write a paneset: one JSON object.");
                string key = written["$schema"]?.GetValue<string>() == "rulealize/ruleset/v1" ? "r" : "p";
                fragment = Fragment.Build((key, Fragment.Pack(written.ToJsonString())));
            }

            opener ??= new Opener(Http, Runtime);
            Opened opened = await opener.OpenAsync(Fragment.Parse(fragment));
            title = opened.View?.Title ?? opened.Session.Context.Id;
            link = BaseUri + Fragment.Build([.. Fragment.Parse(fragment).Select(p => (p.Key, (string?)p.Value))]);
        }
        catch (Exception e)
        {
            problem = e.Message;
        }
    }
}
