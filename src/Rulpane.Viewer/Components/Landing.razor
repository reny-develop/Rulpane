@using System.Text.Json
@using System.Text.Json.Nodes
@using Rulealize
@inject HttpClient Http
@* What a link with nothing in it shows: the bundled samples, and a way to put rules of your own in a link. *@

<div class="landing">
    <section class="hero">
        <div class="hero-copy">
            <span class="chip accent">No server · it all runs in your browser</span>
            <h1>Rules in a link.<br />A screen you can play.</h1>
            <p>
                Rulpane turns a Rulealize rule set carried in the URL into a screen: what it shows, the moves
                it allows, the result it ends on. The rules, the position and every move stay in the link.
            </p>
        </div>

        <div class="card anatomy">
            <h2>The whole screen is in the link</h2>
            <a class="url" href="@(BaseUri + Fragment.Build(("r", "approval"), ("v", "approval"), ("t", "paper"), ("s", ExampleState)))">@Host<span class="r">#r=approval</span><span class="v">&amp;v=approval</span><span class="t">&amp;t=paper</span><span class="s">&amp;s=@ExampleState[..14]…</span></a>
            <dl>
                <dt><span class="chip accent">r</span></dt>
                <dd>The rule set: a bundled name, or the JSON itself, compressed</dd>
                <dt><span class="chip warn">v</span></dt>
                <dd>The view: where each value goes. Left out, the screen is made from the rules</dd>
                <dt><span class="chip">t</span></dt>
                <dd>The theme: colours, corners and type. Left out, it looks like Rulpane</dd>
                <dt><span class="chip ok">s</span></dt>
                <dd>The position. Left out, the rules start from the beginning</dd>
            </dl>
            <p class="note"><Icon Name="back" Size="14" />Every move rewrites the link, so Back is an undo.</p>
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <h2>Samples</h2>
            <p>Rule sets bundled with Rulpane.</p>
        </div>
        <ul class="samples">
            @foreach (Sample sample in Samples)
            {
                <li>
                    <a class="card sample" href="@(BaseUri + Fragment.Build(("r", sample.Name), ("v", sample.View), ("t", sample.Theme)))">
                        <span class="sample-head">@sample.Name@(sample.View is null ? null : " + view")@(sample.Theme is null ? null : " + theme")<Icon Name="arrow" /></span>
                        <p>@sample.Description</p>
                        <span class="tags">
                            @foreach (string tag in sample.Tags)
                            {
                                <span class="chip">@tag</span>
                            }
                        </span>
                    </a>
                </li>
            }
        </ul>
    </section>

    <section class="section">
        <div class="section-head">
            <h2>Templates</h2>
            <p>A view written for no one rule set: it says what it expects, and any rules that have it can use it, under their own names.</p>
        </div>
        <ul class="samples">
            @foreach (Sample sample in Templated)
            {
                <li>
                    <a class="card sample" href="@(BaseUri + Fragment.Build(("r", sample.Name), ("v", sample.View), ("s", sample.Data is null ? null : Fragment.Pack(sample.Data))))">
                        <span class="sample-head">@sample.Name + @sample.Tags[0]<Icon Name="arrow" /></span>
                        <p>@sample.Description</p>
                        <span class="tags">
                            @foreach (string tag in sample.Tags.Skip(1))
                            {
                                <span class="chip">@tag</span>
                            }
                        </span>
                    </a>
                </li>
            }
        </ul>
    </section>

    <section class="section">
        <div class="section-head">
            <h2>Make a link from your own rules</h2>
            <p>Paste a rule set, and a view and a theme if you have them. All are checked here first, so a link this page hands out is one that opens.</p>
        </div>
        <div class="card make">
            <textarea @ref="editor" @bind="document" @bind:event="oninput" rows="8" spellcheck="false"
                      placeholder="Paste the rule set JSON. Comments are dropped from the link."></textarea>
            <textarea class="view-editor" @bind="viewDocument" @bind:event="oninput" rows="4" spellcheck="false"
                      placeholder="Optional: a view (rulealize/view/v1). Left empty, the screen is made from the rules."></textarea>
            <textarea class="view-editor" @bind="themeDocument" @bind:event="oninput" rows="4" spellcheck="false"
                      placeholder="Optional: a theme (rulealize/theme/v1). Left empty, the screen looks like Rulpane."></textarea>
            <div class="make-row">
                <button class="primary" @onclick="Make"><Icon Name="link" />Make link</button>
                @if (link is not null)
                {
                    <span class="made"><Icon Name="check" /><a href="@link">Open @id</a><span class="muted">· @link.Length characters</span></span>
                }
            </div>
            @if (problem is not null)
            {
                <pre class="problem">@problem</pre>
            }
        </div>
    </section>
</div>

@code {
    private sealed record Sample(string Name, string Description, string[] Tags, string? View = null, string? Theme = null, string? Data = null);

    // Each describes the document of the same name in wwwroot/rulesets, its view the one in wwwroot/views, and its theme the one in wwwroot/themes.
    private static readonly Sample[] Samples =
    [
        new("approval", "Draft, review, then approve or reject with a reason.", ["3 inputs", "projection"]),
        new("countdown", "Count to ten, one to three at a time.", ["1 input"]),
        new("reversi", "Reversi on an eight-by-eight board, for two.", ["grid", "actors"]),
        new("blackjack", "Cards are drawn in your browser, weighted by the rules.", ["chance", "actors"]),
        new("tictactoe", "Three in a row, for two.", ["grid", "actors"]),
        new("roster", "A shift roster: put staff on the shifts still open.", ["records"]),
        new("approval", "The same rules, laid out by a view: a claim, its stage, the review.", ["view", "showWhen"], View: "approval"),
        new("countdown", "The total set large; the moves under it.", ["view", "stats"], View: "countdown"),
        new("roster", "Who is on which shift, as tables, with a block of moves for each input.", ["view", "table"], View: "roster"),
        new("reversi", "The board drawn square by square: choose a square to place there.", ["view", "board"], View: "reversi"),
        new("approval", "The claim again, on paper: warm colours, a serif, square corners.", ["theme"], View: "approval", Theme: "paper"),
        new("roster", "The roster, rounder and closer together, in green.", ["theme", "compact"], View: "roster", Theme: "meadow"),
    ];

    // A template's name comes first among the tags. The official rule sets open with nothing in
    // them, since what is requested, signed or ticked off is the state's to say, so these start
    // from the example in each one's repository.
    private static readonly Sample[] Templated =
    [
        new("request", "Rulealize.RuleSet.Request, which projects its stage under that very name.", ["stages", "official", "as it is"], View: "stages",
            Data: """{"subjects":["mon-am","mon-pm","tue-am"],"stage":"draft","subject":null}"""),
        new("approval", "The same template on the approval rules, which keep the stage in summary.", ["stages", "bind"], View: "approval-stages"),
        new("checklist", "Rulealize.RuleSet.Checklist: steps done in any order. Its lists are state fields.", ["progress", "official", "bind $"], View: "checklist-progress",
            Data: """{"steps":["contract","equipment","induction","payroll"],"done":["contract"]}"""),
        new("signatures", "Rulealize.RuleSet.Signatures: the same template, counting who has signed.", ["progress", "official", "bind"], View: "signatures-progress",
            Data: """{"signatories":["ann","bo","cy"],"required":2,"signed":[],"outcome":"open"}"""),
        new("tictactoe", "A board game that projects its turn by the name the template expects; the board is bound to its state field.", ["grid-game", "bind $"], View: "tictactoe-grid-game"),
        new("reversi", "The same template on reversi, whose board and turn are state fields. Passing is under the board.", ["grid-game", "bind $"], View: "reversi-grid-game"),
    ];

    // approval, submitted and waiting for review.
    private const string ExampleState = "z:q1YqLklMT1WyUipKLctMLVfSATISi_PzlKzySnNyagE";

    [Parameter, EditorRequired] public string BaseUri { get; set; } = default!;
    [Parameter, EditorRequired] public RuleRuntime Runtime { get; set; } = default!;

    /// <summary>Whether the link asked for the editor, as the bar's "Make a link" does.</summary>
    [Parameter] public bool FocusEditor { get; set; }

    private ElementReference editor;
    private bool focused;
    private string document = "";
    private string viewDocument = "";
    private string themeDocument = "";
    private string? problem;
    private string? link;
    private string? id;

    private string Host => new Uri(BaseUri).Host + new Uri(BaseUri).AbsolutePath;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusEditor && !focused)
        {
            focused = true;
            await editor.FocusAsync();
        }

        focused &= FocusEditor;
    }

    // Compiled before a link is made, so a link this page hands out is one that opens.
    private async Task Make()
    {
        problem = null;
        link = null;
        try
        {
            RuleContext context = Runtime.CreateContext(document);
            string? view = null;
            if (!string.IsNullOrWhiteSpace(viewDocument))
            {
                string? template = View.TemplateOf(viewDocument) is string name ? await Source.View(name).ReadAsync(Http) : null;
                View.Parse(viewDocument, context, document, template);
                view = Fragment.Pack(Minify(viewDocument));
            }

            string? theme = null;
            if (!string.IsNullOrWhiteSpace(themeDocument))
            {
                Theme.Parse(themeDocument);
                theme = Fragment.Pack(Minify(themeDocument));
            }

            id = context.RuleSet;
            link = BaseUri + Fragment.Build(("r", Fragment.Pack(Minify(document))), ("v", view), ("t", theme));
        }
        catch (Exception e)
        {
            problem = e.Message;
        }
    }

    // Comments are for whoever edits the document; a link only has to run it.
    private static string Minify(string json) =>
        JsonNode.Parse(json, documentOptions: new JsonDocumentOptions
        {
            CommentHandling = JsonCommentHandling.Skip,
            AllowTrailingCommas = true,
        })!.ToJsonString();
}
